  "import_instructions": {
    "description": "How to import sample data into PouchDB",
    "steps": [
      "1. Open browser console on the demo page",
      "2. Load the sample data from this JSON file",
      "3. Run: personApp.db.bulkDocs(sampleData.data_for_import.docs)",
      "4. The UI will automatically refresh with the new persons"
    ],
    "example_code": "fetch('person-sample-data.json')\n  .then(r => r.json())\n  .then(data => personApp.db.bulkDocs(data.data_for_import.docs))\n  .then(() => console.log('Sample data imported!'))\n  .catch(err => console.error('Import failed:', err));"
  },
  "validation_rules": {
    "required_fields": [
      "firstName",
      "primaryEmail",
      "username"
    ],
    "username": {
      "unique": true,
      "case_insensitive": true,
      "min_length": 3,
      "pattern": "alphanumeric and underscores"
    },
    "primaryEmail": {
      "format": "email",
      "unique": false
    },
    "gender": {
      "enum": ["M", "F", "O"]
    },
    "dateOfBirth": {
      "format": "ISO 8601 date (YYYY-MM-DD)"
    },
    "fatherId": {
      "format": "person:uuid",
      "must_exist": true
    },
    "motherId": {
      "format": "person:uuid",
      "must_exist": true
    }
  },
  "password_notes": {
    "demo_hash": "SHA-256 (not secure for production)",
    "production_recommendation": "bcrypt or Argon2",
    "example_plaintext": "password123",
    "example_sha256_hash": "5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8"
  }
